@model WebMinerva.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h1>Eliminar Producto</h1>

<h3>¿Está seguro que desea dar de baja este elemento?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Codigo)</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class="col-sm-2">Unidad de Medida</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IdUnidadMedidaNavigation.Descripcion)</dd>

        <dt class="col-sm-2">Saldo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Saldo)</dd>

        <dt class="col-sm-2">Precio de Venta</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PrecioVenta)</dd>

        <dt class="col-sm-2">Usuario Registro</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.UsuarioRegistro)</dd>

        <dt class="col-sm-2">Fecha Registro</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaRegistro)</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>
