@model WebMinerva.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<section class="membership-section section-padding" id="section_3">
    <div class="container">
        <div class="row">
            <div class="col-12 mt-5 mb-3 mb-lg-0 text-center mx-auto ">
                <div class="col-lg-12 col-12 mb-lg-5 mb-4">
                    <h2>Crear Productos</h2>
                </div>

                <hr />
                <div class="row">
                    <div class="col-md-4">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label class="control-label">Código</label>
                                <input asp-for="Codigo" class="form-control" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Descripción</label>
                                <input asp-for="Descripcion" class="form-control" />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Unidad de Medida</label>
                                <select asp-for="IdUnidadMedida" class="form-select" asp-items="ViewBag.UnidadesMedida" required>
                                    <option disabled selected value="">Seleccione un elemento</option>
                                </select>
                                <span asp-validation-for="IdUnidadMedida" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Saldo</label>
                                <input asp-for="Saldo" class="form-control" />
                                <span asp-validation-for="Saldo" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Precio de Venta</label>
                                <input asp-for="PrecioVenta" class="form-control" />
                                <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <input type="submit" value="Guardar" class="btn btn-primary" />
                            </div>
                        </form>
                    </div>
                </div>

                <div>
                    <a asp-action="Index">Volver a la lista</a>
                </div>
            </div>
        </div>
    </div>
</section>